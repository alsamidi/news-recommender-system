# Copy to .env and fill in locally. NEVER commit .env.
# .env is already ignored by .gitignore.

# ---------------------------------------------------------------------------
# Demo persona (optional)
# ---------------------------------------------------------------------------
# A demo account mapped to a MIND dataset user that HAS ALS factors.
# The account is created only by:  python -m src.web.seed_persona
# Re-running that command updates the existing account (idempotent).
# Leave the email/password empty to skip persona provisioning entirely.
#
# Verified eligible examples: U10045, U10062, U10103
# Do NOT put real user credentials here.
WEB_DEMO_PERSONA_USER_ID=U10045
WEB_DEMO_PERSONA_EMAIL=
WEB_DEMO_PERSONA_PASSWORD=

# ---------------------------------------------------------------------------
# Web app (optional overrides; defaults live in src/web/config.py)
# ---------------------------------------------------------------------------
# WEB_DB_PATH=data/web.db
# WEB_SESSION_TTL_DAYS=7
# WEB_HISTORY_LIMIT=50
# WEB_FEED_LIMIT=10
# WEB_REC_TOP_K=30
