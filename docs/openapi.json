{
  "openapi": "3.1.0",
  "info": {
    "title": "TA News Recommendation API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/recommend": {
      "post": {
        "summary": "Recommend",
        "operationId": "recommend_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/similar/{nid}": {
      "get": {
        "summary": "Similar",
        "operationId": "similar_similar__nid__get",
        "parameters": [
          {
            "name": "nid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Nid"
            }
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Top K"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/article/{nid}": {
      "get": {
        "summary": "Article",
        "operationId": "article_article__nid__get",
        "parameters": [
          {
            "name": "nid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Nid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArticleDetailResponse": {
        "properties": {
          "nid": {
            "type": "string",
            "title": "Nid"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "abstract": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstract"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          }
        },
        "type": "object",
        "required": [
          "nid"
        ],
        "title": "ArticleDetailResponse"
      },
      "ArticleResponse": {
        "properties": {
          "nid": {
            "type": "string",
            "title": "Nid"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "nid",
          "score"
        ],
        "title": "ArticleResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "alpha": {
            "type": "number",
            "title": "Alpha"
          },
          "catalog_size": {
            "type": "integer",
            "title": "Catalog Size"
          },
          "als_items": {
            "type": "integer",
            "title": "Als Items"
          }
        },
        "type": "object",
        "required": [
          "status",
          "alpha",
          "catalog_size",
          "als_items"
        ],
        "title": "HealthResponse"
      },
      "RecommendRequest": {
        "properties": {
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "history": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "History"
          },
          "top_k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 10
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "hybrid"
          }
        },
        "type": "object",
        "title": "RecommendRequest"
      },
      "RecommendResponse": {
        "properties": {
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/ArticleResponse"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "model_used": {
            "type": "string",
            "title": "Model Used"
          },
          "alpha": {
            "type": "number",
            "title": "Alpha"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "recommendations",
          "model_used",
          "alpha",
          "mode"
        ],
        "title": "RecommendResponse"
      },
      "SimilarResponse": {
        "properties": {
          "nid": {
            "type": "string",
            "title": "Nid"
          },
          "similar": {
            "items": {
              "$ref": "#/components/schemas/ArticleResponse"
            },
            "type": "array",
            "title": "Similar"
          }
        },
        "type": "object",
        "required": [
          "nid",
          "similar"
        ],
        "title": "SimilarResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}